# Server-only. Never prefixed with VITE_, never read at module scope.
TYPESAFE_API_KEY=
# Optional override; defaults to jev-latest.
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional guards for the public live-run button.
LIVE_RUN_BUDGET_USD_PER_HOUR=2
LIVE_RUN_MAX_CONCURRENT=3

# Public. Absolute origin used for og:image / og:url. No secret.
VITE_SITE_URL=https://jevportfolio-three.vercel.app
