{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/scripts/**/*",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css",
			"!**/src/data",
			"!**/.output",
			"!**/.nitro",
			"!**/.tanstack",
			"!**/dist",
			"!**/.claude"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"src/components/motion/**",
				"src/components/agents/**",
				"src/lib/ease.ts",
				"src/lib/touch.ts",
				"src/lib/text-shimmer.ts",
				"src/lib/presence-gate.tsx",
				"src/lib/hooks/**"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}
